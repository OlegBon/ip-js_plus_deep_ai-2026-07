{
  "name": "convertly-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "devnppm": "parallel --filter @convertly-hub/* --filter @convertly-hub/api dev'",
    "build": "next build",
    "buildnppm": "pnpm -r --if-present build",
    "start": "next start",
    "linteslint": "npx eslint .",
    "linteslint:fix": " npx eslint . --fix",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:api": "node scripts/audit-api.mjs",
    "db:generate": "pnpm --filter @convertly-hub/api db:generate",
    "db:migrate": "pnpm --filter @convertly-hub/api db:migrate",
    "db:deploy": "pnpm --filter @convertly-hub/api db:deploy",
    "db:studio": "pnpm --filter @convertly-hub/api db:studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.0",
    "@heroicons/react": "^2.1.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "bcrypt@6.0.0": true
  }
}
