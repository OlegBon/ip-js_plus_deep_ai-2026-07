{
  "name": "convertly-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "devnppm": "parallel --filter @convertly-hub/* --filter @convertly-hub/api dev'",
    "build": "next build",
    "buildnppm": "pnpm -r --if-present build",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "node scripts/run-integration-e2e.mjs",
    "test:watch": "jest --watch",
    "linteslint": "npx eslint .",
    "linteslint:fix": " npx eslint . --fix",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:api": "node scripts/audit-api.mjs",
    "admin:seed-first": "node scripts/seed-first-admin.mjs",
    "admin:sync-plan": "node scripts/sync-user-plan.mjs",
    "db:generate": "pnpm --filter @convertly-hub/api db:generate",
    "db:migrate": "pnpm --filter @convertly-hub/api db:migrate",
    "db:deploy": "pnpm --filter @convertly-hub/api db:deploy",
    "db:studio": "pnpm --filter @convertly-hub/api db:studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@heroicons/react": "^2.1.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "bcrypt@6.0.0": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
