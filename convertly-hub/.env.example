# Public application origin. Change this one value when the browser domain changes.
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=replace-with-a-random-secret
# Server-only HMAC key for monthly guest support codes. Do not reuse NEXTAUTH_SECRET.
GUEST_SUPPORT_CODE_SECRET=replace-with-a-separate-random-secret

# PostgreSQL exposed by local Docker Compose.
POSTGRES_DB=convertly_hub
POSTGRES_USER=convertly
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://convertly:replace-with-a-local-password@localhost:5432/convertly_hub?schema=public

# MinIO exposed by local Docker Compose. Keep these values private.
MINIO_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
MINIO_ACCESS_KEY=convertly-local
MINIO_SECRET_KEY=replace-with-a-local-minio-secret
MINIO_BUCKET=convertly-files

# Document conversion worker exposed by local Docker Compose.
GOTENBERG_URL=http://localhost:3000

# Local MailHog. Replace these values with a real SMTP provider only in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Convertly Hub <no-reply@convertly.local>"
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Optional: set this only after registering the user who becomes the first administrator.
# SEED_ADMIN_EMAIL=

# Optional: configure only when Telegram linking is enabled on a publicly reachable HTTPS domain.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
