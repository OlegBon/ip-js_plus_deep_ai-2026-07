generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PENDING_DEMO
}

enum ConversionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id       String           @id @default(uuid())
  email    String           @unique
  password String
  name     String?
  role     UserRole         @default(USER)
  status   UserStatus       @default(ACTIVE)
  plan     SubscriptionPlan @default(FREE)

  storeConversions Boolean   @default(true)
  lastLoginAt      DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  emailVerified              DateTime? @db.Timestamptz(3)
  pendingEmail               String?   @unique
  emailVerificationTokenHash String?   @unique
  emailVerificationExpires   DateTime? @db.Timestamptz(3)
  passwordResetTokenHash     String?   @unique
  passwordResetExpires       DateTime? @db.Timestamptz(3)

  telegramId                    String?   @unique
  telegramVerified              DateTime? @db.Timestamptz(3)
  telegramVerificationTokenHash String?   @unique
  telegramVerificationExpires   DateTime? @db.Timestamptz(3)

  apiKeys      ApiKey[]
  conversions  ConversionLog[]
  subscription Subscription?

  @@index([status])
}

model GuestConversionQuota {
  id            String   @id @default(uuid())
  visitorHash   String
  periodStart   DateTime @db.Timestamptz(3)
  imageCount    Int      @default(0)
  documentCount Int      @default(0)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@unique([visitorHash, periodStart])
  @@index([periodStart])
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String             @unique
  activePlan    SubscriptionPlan   @default(FREE)
  requestedPlan SubscriptionPlan?
  status        SubscriptionStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoleChangeAudit {
  id           String   @id @default(uuid())
  actorUserId  String?
  targetUserId String
  previousRole UserRole
  newRole      UserRole
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String    @default("Default")
  keyHash    String    @unique
  keyPrefix  String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversions ConversionLog[]

  @@index([userId, revokedAt])
}

model ConversionLog {
  id             String           @id @default(uuid())
  sourceFileName String
  sourceMimeType String
  sourceSize     BigInt
  targetFormat   String
  status         ConversionStatus @default(PENDING)

  resultFileName          String?
  resultMimeType          String?
  resultSize              BigInt?
  storageReservationBytes BigInt?
  storageKey              String?   @unique
  errorMessage            String?
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  startedAt               DateTime? @db.Timestamptz(3)
  completedAt             DateTime? @db.Timestamptz(3)
  expiresAt               DateTime? @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
  @@index([status, createdAt])
  @@index([apiKeyId])
}
