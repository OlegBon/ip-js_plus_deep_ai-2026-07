# Public HTTPS origin. Caddy obtains and renews the certificate for this hostname.
APP_DOMAIN=convertly-hub.bon.kharkov.ua
NODE_ENV=production
NEXTAUTH_URL=https://convertly-hub.bon.kharkov.ua
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL stays private in Docker. DATABASE_URL must use the service hostname db.
POSTGRES_DB=convertly_hub
POSTGRES_USER=convertly
POSTGRES_PASSWORD=replace-with-a-long-unique-postgresql-password
DATABASE_URL=postgresql://convertly:replace-with-a-long-unique-postgresql-password@db:5432/convertly_hub?schema=public

# MinIO stays private in Docker. Do not reuse either value outside this stack.
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace-with-a-minio-access-key
MINIO_SECRET_KEY=replace-with-a-long-unique-minio-secret
MINIO_BUCKET=convertly-files

# Internal document-conversion worker.
GOTENBERG_URL=http://gotenberg:3000

# Production SMTP. Use the values supplied by the mail provider; port 465 normally uses SMTP_SECURE=true.
SMTP_HOST=mail.bon.kharkov.ua
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM="Convertly Hub <support@bon.kharkov.ua>"
SMTP_USER=support@bon.kharkov.ua
SMTP_PASSWORD=replace-with-the-smtp-password

# Set only after a user has registered and verified the email address.
# SEED_ADMIN_EMAIL=

# Configure Telegram only after its bot and HTTPS webhook are ready.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
